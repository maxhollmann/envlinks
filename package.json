{
  "name": "envlinks",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "prebuild": "node scripts/generate-config.js",
    "build": "rollup -c",
    "generate-config": "./scripts/generate-config.sh public/config.js",
    "start": "sirv public --no-clear",
    "dev": "env-cmd -- sh -c './scripts/generate-config.sh public/config.js && rollup -c -w'",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.0",
    "babel-jest": "^27.1.0",
    "env-cmd": "^10.1.0",
    "jest": "^27.1.0",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.2",
    "rollup-plugin-terser": "^7.0.0",
    "sirv-cli": "^1.0.0",
    "svelte": "^5.55.9"
  },
  "dependencies": {
    "@rollup/plugin-replace": "^3.0.0"
  }
}
